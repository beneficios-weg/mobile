# Public API address for Android/Capacitor. VITE_* values are bundled in the app; never put secrets here.
VITE_API_URL=https://weg-benefits-api.onrender.com
# Browser development: same-origin local proxy preserves the API session cookie.
VITE_API_PROXY_PATH=/backend
API_PROXY_TARGET=https://weg-benefits-api.onrender.com
# To use a locally running API instead:
# API_PROXY_TARGET=http://localhost:8081
